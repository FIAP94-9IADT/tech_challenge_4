# Copie para .env e preencha. Sem as chaves, o sistema roda em modo local (fallback)
# e sinaliza nos resultados que o Azure não foi utilizado.

# Azure AI Speech (Speech to Text)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth

# Azure AI Language (Text Analytics: sentimento, frases-chave, entidades, Text Analytics for Health)
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_ENDPOINT=https://<seu-recurso>.cognitiveservices.azure.com/

# Webhook para alertas (Microsoft Teams Workflows, Slack ou endpoint próprio)
ALERT_WEBHOOK_URL=
# teams | slack | generic
ALERT_WEBHOOK_FORMAT=teams
